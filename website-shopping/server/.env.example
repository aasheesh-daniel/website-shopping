# MongoDB Atlas: Atlas > Connect > Drivers > copy the string, put your password in, add a database name at the end
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/website-shopping?retryWrites=true&w=majority
PORT=5000
# Any long random text. Needed only to read your leads: GET /api/ideas with header x-admin-key
ADMIN_KEY=change-this-to-a-long-random-text
# After you deploy the website, put its address here (comma separated). Leave empty while testing.
CLIENT_ORIGIN=
